[user]
  name = "Your Name"
  email = "you@example.com"
  # Optional: paste the public key from your 1Password SSH Key item here.
  # signingkey = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"

# Optional: 1Password SSH commit signing
# Register the same public key with your Git host as a signing key.
# [commit]
#   gpgsign = true
# [gpg]
#   format = ssh
# [gpg "ssh"]
#   program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
