ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"

if [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
  source "$ZINIT_HOME/zinit.zsh"
  zinit ice depth=1
  zinit light zsh-users/zsh-completions
else
  print -u2 'zinit is missing; run mise bootstrap from ~/src/dotfiles.'
fi

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always "$realpath"'

# Generated by bootstrap from the installed tools, outside the dotfiles repo.
fpath=("${XDG_CACHE_HOME:-$HOME/.cache}/zsh/generated-completions" $fpath)

# Run after zsh-completions adds its functions to fpath, with security checks.
autoload -Uz compinit
compinit

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza -1 --color=always "$realpath"'

autoload -Uz edit-command-line
zle -N edit-command-line
for keymap in emacs viins vicmd; do
  bindkey -M "$keymap" '^X^E' edit-command-line
done
unset keymap

if (( $+functions[zinit] )); then
  zinit cdreplay -q
  zinit ice depth=1
  zinit light Aloxaf/fzf-tab
  zinit ice depth=1
  zinit light zsh-users/zsh-history-substring-search

  HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
  for keymap in emacs viins vicmd; do
    bindkey -M "$keymap" '^[[A' history-substring-search-up
    bindkey -M "$keymap" '^[[B' history-substring-search-down
    bindkey -M "$keymap" '^[OA' history-substring-search-up
    bindkey -M "$keymap" '^[OB' history-substring-search-down
  done
  unset keymap
  bindkey -M emacs '^P' history-substring-search-up
  bindkey -M emacs '^N' history-substring-search-down

  if (( $+commands[deja] )); then
    zinit ice depth=1 pick'deja.plugin.zsh'
    zinit light Giammarco-Ferranti/deja
  fi

  # Last so it sees every widget installed above (including Deja and fzf-tab).
  zinit ice depth=1
  zinit light zsh-users/zsh-syntax-highlighting
fi
