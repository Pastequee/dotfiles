# mise (binary may live in ~/.local/bin before PATH is fully set)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

export ZSH_DIR="$HOME/.config/zsh"

source "$ZSH_DIR/export.zsh"
source "$ZSH_DIR/alias.zsh"
source "$ZSH_DIR/functions.zsh"

export HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=1000000
SAVEHIST=1000000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS HIST_REDUCE_BLANKS NO_BEEP HIST_IGNORE_SPACE
# SHARE_HISTORY already appends immediately; zsh recommends not combining these.
unsetopt INC_APPEND_HISTORY INC_APPEND_HISTORY_TIME
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

[[ -f "$ZSH_DIR/local.zsh" ]] && source "$ZSH_DIR/local.zsh"

# opencode
export PATH=/Users/arthur/.opencode/bin:$PATH

# bun global packages
export PATH="/Users/arthur/.bun/bin:$PATH"

# Load after local widgets and fzf's shell integration.
source "$ZSH_DIR/plugins.zsh"

case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
